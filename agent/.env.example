# Имя хоста в мониторинге — попадёт в лейбл host и в текст алертов.
MON_HOST_NAME=node1

# Роль хоста в панели: data | cron | master | node | sub | bot
MON_ROLE=node

# Приёмник remote_write на central и его Bearer-токен (из mon-bundle).
MON_ENDPOINT=https://mon.example.com/push
MON_TOKEN=REPLACE_ME

# true только если у central самоподписанный сертификат (домен — IP или имя без точки).
MON_TLS_INSECURE=false

# Внешняя docker-сеть панели на этом хосте. Точное имя:
#   docker network ls --format '{{.Name}}' | grep -E '_(panel|sub|bot|cron)-net$|_default$'
PANEL_NETWORK=itg-panel_panel-net

# Куда бить /healthz внутри сети панели:
#   master, node, sub -> backend:5000     bot -> bot-api:5000     cron -> cron:5000
HEALTHZ_TARGET=backend:5000

# gRPC Stats API xray. Только для роли node.
XRAY_API_ENDPOINT=xray:10085

# Профили compose: healthz (все кроме data) | healthz,xray (node) | data (data tier)
COMPOSE_PROFILES=healthz,xray

# Только для роли data — заполняется installer'ом из .env панели.
# sslmode=require, а не verify-full: сертификат выписан на DATA_HOSTNAME,
# а ходим по имени postgres внутри машины, где verify-full не пройдёт по построению.
PG_DSN=
REDIS_ADDR=
# ACL-юзер Redis: monitoring умеет INFO и CONFIG GET и не читает ни одного ключа.
# У панели до этой версии его не было — там придётся оставить panel, но он не может
# INFO, и метрик Redis не будет: обнови панель и перезапусти на data-хосте redis.
REDIS_USER=monitoring
REDIS_PASSWORD=

# У docker_stats_exporter нет версионных тегов — только latest.
DOCKERSTATS_TAG=latest

# Версия xray-exporter. Пин, а не latest: иначе каждая нода ловит тот образ,
# что был свежим в день её установки, и версии по флоту расходятся.
XRAY_EXPORTER_TAG=v0.6.4
