# Домен central-сервера. Caddy выпустит на него сертификат через ACME —
# домен должен резолвиться сюда, а :80 быть доступен из интернета.
# IP или имя без точки тоже работают: Caddy выдаст внутренний сертификат,
# но агентам придётся слать с MON_TLS_INSECURE=true.
MON_DOMAIN=mon.example.com

# Bearer-токен, которым агенты авторизуются на /push. Генерится installer'ом.
MON_TOKEN=REPLACE_ME

# Пароль admin в Grafana.
GRAFANA_ADMIN_PASSWORD=REPLACE_ME

# Срок хранения метрик.
PROM_RETENTION=30d

# Alertmanager → Telegram.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
